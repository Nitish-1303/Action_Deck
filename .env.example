# Select "gemini" or "groq"; set a server-side provider key.
LLM_PROVIDER=gemini
LLM_API_KEY=

# Optional Neatlogs project key. Never commit a real key.
NEATLOGS_API_KEY=

# Development-only payload capture for exact built-in synthetic samples.
# Production ignores this setting.
NEATLOGS_LOG_PAYLOADS=false
